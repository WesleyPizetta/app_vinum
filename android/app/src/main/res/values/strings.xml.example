<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Web Client ID do Google Cloud Console (tipo "Aplicativo Web").
        Usado pelo google_sign_in para Android sem Firebase.
        Mesmo valor que GOOGLE_WEB_CLIENT_ID no .env

        Copie este arquivo para strings.xml e substitua o placeholder:
          cp strings.xml.example strings.xml
    -->
    <string name="default_web_client_id"><SEU_WEB_CLIENT_ID>.apps.googleusercontent.com</string>
</resources>
