# Supabase — Settings > API
SUPABASE_URL=https://<SEU_PROJECT_ID>.supabase.co
SUPABASE_ANON_KEY=<SUA_ANON_KEY>

# URL do BFF local
# Emulador Android  → http://10.0.2.2:8080
# Dispositivo físico → http://<IP_DA_SUA_MAQUINA>:8080
# iOS Simulator     → http://localhost:8080
BFF_API_URL=http://10.0.2.2:8080

# Google OAuth — Google Cloud Console > Credenciais > OAuth 2.0
GOOGLE_WEB_CLIENT_ID=<SEU_WEB_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=<SEU_IOS_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=<SEU_ANDROID_CLIENT_ID>.apps.googleusercontent.com

# Firebase Web (Opcional — necessário se for executar no modo Web)
FIREBASE_WEB_API_KEY=<SUA_FIREBASE_WEB_API_KEY>
FIREBASE_WEB_APP_ID=<SEU_FIREBASE_WEB_APP_ID>
FIREBASE_WEB_MESSAGING_SENDER_ID=<SEU_FIREBASE_MESSAGING_SENDER_ID>
FIREBASE_WEB_PROJECT_ID=<SEU_FIREBASE_PROJECT_ID>
